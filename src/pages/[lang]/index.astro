---
// Language landing pages: /de/, /fr/, /es/ ...
// One page is built for every JSON file in src/data/lang-pages/.
// Prices, buy links and download link come from site.config.json (single source of truth),
// so a price change never needs touching 57 files.
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../site.config.json';
import languages from '../../data/languages.json';

export function getStaticPaths() {
  const files = import.meta.glob('../../data/lang-pages/*.json', { eager: true });
  return Object.entries(files).map(([path, mod]) => {
    const code = path.split('/').pop().replace('.json', '');
    return { params: { lang: code }, props: { t: mod.default ?? mod } };
  });
}

const { t } = Astro.props;
const total = languages.length;
const tiers = site.pricing.tiers;
const tier = (name) => tiers.find(x => x.name.startsWith(name));
const free = tier('Starter');
const personal = tier('Personal');
const pro = tier('Professional');

// Price cards: price + buy URL from config, words from the language file
const cards = [
  { key: 'free', cfg: free, highlighted: false },
  { key: 'personal', cfg: personal, highlighted: false },
  { key: 'professional', cfg: pro, highlighted: true }
].map(c => ({ ...c, copy: t.pricing.tiers[c.key] }));

const fill = (s) => s.replaceAll('{total}', String(total)).replaceAll('{personalPrice}', personal.price.replace('$', ''));

const extraSchema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": t.htmlLang,
    "mainEntity": t.faq.map(f => ({
      "@type": "Question",
      "name": fill(f.q),
      "acceptedAnswer": { "@type": "Answer", "text": fill(f.a) }
    }))
  }
];
---
<BaseLayout
  title={fill(t.meta.title)}
  seoTitle={fill(t.meta.seoTitle)}
  description={fill(t.meta.description)}
  lang={t.htmlLang}
  extraSchema={extraSchema}
>
  <section class="section-pad lp-hero">
    <div class="container lp-narrow">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="lp-h1">{fill(t.hero.h1)}</h1>
      <p class="lp-lead">{fill(t.hero.lead)}</p>
      <div class="lp-ctas">
        <a href={site.download.url} class="btn-primary">{t.hero.ctaDownload}</a>
        <a href="#prices" class="btn-secondary">{t.hero.ctaPrices}</a>
      </div>
      <p class="muted lp-small">{fill(t.hero.note)}</p>
    </div>
  </section>

  <section class="section-pad section-neutral">
    <div class="container">
      <h2 class="lp-h2">{t.benefits.heading}</h2>
      <div class="lp-grid3">
        {t.benefits.items.map(b => (
          <div class="lp-card"><h3>{b.title}</h3><p class="muted">{fill(b.text)}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container lp-narrow">
      <h2 class="lp-h2">{t.steps.heading}</h2>
      <ol class="lp-steps">
        {t.steps.items.map(s => (<li><strong>{s.title}</strong> {s.text}</li>))}
      </ol>
    </div>
  </section>

  <section class="section-pad section-neutral" id="prices">
    <div class="container">
      <h2 class="lp-h2">{t.pricing.heading}</h2>
      <p class="muted lp-center">{t.pricing.sub}</p>
      <div class="lp-grid3 lp-prices">
        {cards.map(c => (
          <div class={`lp-card lp-price ${c.highlighted ? 'lp-hl' : ''}`}>
            {c.highlighted && t.pricing.badge && <span class="lp-badge">{t.pricing.badge}</span>}
            <h3>{c.copy.name}</h3>
            <div class="lp-amount">{c.key === 'free' ? t.pricing.freeLabel : `${c.cfg.price} USD`}<span>{c.key === 'free' ? '' : ` ${t.pricing.perYear}`}</span></div>
            <p class="muted">{c.copy.description}</p>
            <ul>{c.copy.features.map(f => <li>{f}</li>)}</ul>
            <a href={c.cfg.ctaUrl} class={c.highlighted ? 'btn-primary' : 'btn-secondary'}>{c.copy.cta}</a>
          </div>
        ))}
      </div>
      <p class="muted lp-small lp-center">{t.pricing.disclaimer}</p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container lp-narrow">
      <h2 class="lp-h2">{t.faqHeading}</h2>
      {t.faq.map(f => (
        <details class="lp-faq"><summary>{fill(f.q)}</summary><p>{fill(f.a)}</p></details>
      ))}
      <p class="muted lp-small" style="margin-top:24px"><a href="/languages">{fill(t.allLanguagesLink)}</a></p>
    </div>
  </section>

  <style>
    .lp-narrow { max-width: 820px; }
    .lp-h1 { font-size: clamp(28px, 4vw, 42px); font-weight: 800; margin-bottom: 16px; }
    .lp-h2 { margin-bottom: 20px; }
    .lp-lead { font-size: 17px; line-height: 1.7; margin-bottom: 24px; }
    .lp-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
    .lp-small { font-size: 13px; }
    .lp-center { text-align: center; }
    .lp-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .lp-card { background: #fff; border: 1px solid rgba(0,0,0,.08); border-radius: 12px; padding: 24px; }
    .lp-card h3 { margin-bottom: 8px; }
    .lp-steps { padding-left: 20px; line-height: 1.8; }
    .lp-steps li { margin-bottom: 8px; }
    .lp-prices { margin: 24px 0 16px; }
    .lp-price { position: relative; display: flex; flex-direction: column; }
    .lp-price ul { list-style: none; padding: 0; margin: 16px 0 24px; flex: 1; }
    .lp-price li { padding: 4px 0 4px 22px; position: relative; font-size: 14px; }
    .lp-price li::before { content: "✓"; position: absolute; left: 0; color: #B23A26; font-weight: 700; }
    .lp-amount { font-size: 32px; font-weight: 800; margin: 8px 0; }
    .lp-amount span { font-size: 14px; font-weight: 500; opacity: .7; }
    .lp-hl { border: 2px solid #B23A26; }
    .lp-badge { position: absolute; top: -12px; left: 24px; background: #B23A26; color: #fff; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .lp-faq { border-bottom: 1px solid rgba(0,0,0,.1); padding: 14px 0; }
    .lp-faq summary { cursor: pointer; font-weight: 600; }
    .lp-faq p { margin-top: 10px; line-height: 1.7; }
    @media (max-width: 860px) { .lp-grid3 { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
