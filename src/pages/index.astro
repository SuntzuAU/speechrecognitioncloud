---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site.config.json';
import manifest from '../data/image-manifest.json';
const c = site.colours;
const R2 = import.meta.env.PUBLIC_R2_BASE || '';

function imgSrc(key) {
  const entry = manifest[key];
  if (!entry?.r2Key || !R2) return '';
  return `${R2.replace(/\/$/, '')}/${entry.r2Key}`;
}
function imgAlt(key) {
  return manifest[key]?.altText || key;
}
function imgW(key) { return manifest[key]?.width || undefined; }
function imgH(key) { return manifest[key]?.height || undefined; }
function premiumBadgeText(tier) {
  if (tier === 'pro') return 'PRO';
  return 'PRO & MEDICAL';
}

// SoftwareApplication schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": site.structuredData.type,
  "name": site.structuredData.name,
  "description": site.structuredData.description,
  "applicationCategory": site.structuredData.applicationCategory,
  "operatingSystem": site.structuredData.operatingSystem,
  "downloadUrl": site.structuredData.downloadUrl,
  "url": site.siteUrl,
  "isAccessibleForFree": site.structuredData.isAccessibleForFree,
  "areaServed": site.structuredData.areaServed,
  "availableLanguage": site.structuredData.availableLanguage,
  "sameAs": site.structuredData.sameAs,
  "publisher": {
    "@type": "Organization",
    "name": site.organization.name,
    "url": site.organization.url
  },
  "brand": {
    "@type": "Brand",
    "name": site.structuredData.name
  },
  "featureList": site.structuredData.featureList,
  "offers": site.structuredData.offers.map(o => ({
    "@type": "Offer",
    "name": o.name,
    "price": o.price,
    "priceCurrency": o.priceCurrency,
    "availability": o.availability,
    "url": o.url,
    "description": o.description
  }))
};

// FAQPage schema from homepage FAQ
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": site.faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const extraSchema = [softwareSchema, faqSchema];
---
<BaseLayout extraSchema={extraSchema}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="https://demo.speechrecognition.cloud/styles/demo.css" />
  <link rel="preconnect" href="https://challenges.cloudflare.com" />

<div class="hp">

  <!-- 1. HERO + LIVE DEMO -->
  <section class="hp-hero">
    <div class="hp-wrap">
      <h1 class="hp-kicker hp-kicker-h1">Speech recognition for Windows · Free forever, 30 days of Professional on us</h1>
      <p class="hp-h1">Hold the spacebar.<br /><em>Say something.</em></p>
      <div class="hp-hero-sub">
        <p class="hp-hero-line">Professional speech recognition for healthcare, legal, education, government and enterprise.</p>
        <p class="hp-hero-note">Try it below: the real engine, in your browser, punctuation included. Every signup gets 30 days of Professional, unlimited.</p>
      </div>

      <ol class="hp-steps">
        <li><span class="hp-num">1</span>Hold your <kbd>SPACEBAR</kbd></li>
        <li class="hp-arrow" aria-hidden="true">&rarr;</li>
        <li><span class="hp-num">2</span>Say a sentence</li>
        <li class="hp-arrow" aria-hidden="true">&rarr;</li>
        <li><span class="hp-num">3</span>Let go. It types.</li>
      </ol>

      <div class="hp-laptop" id="hp-demo">
        <div class="hp-lid">
          <div class="hp-screen">
            <div class="hp-mail">
              <div class="hp-titlebar">
                <span class="hp-appname">Mail</span>
                <span class="hp-search"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>Search</span>
                <span class="hp-winctl" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10"><line x1="0" y1="5" x2="10" y2="5" stroke="#fff"/></svg><svg width="10" height="10" viewBox="0 0 10 10"><rect x=".5" y=".5" width="9" height="9" fill="none" stroke="#fff"/></svg><svg width="10" height="10" viewBox="0 0 10 10"><path d="M0 0l10 10M10 0L0 10" stroke="#fff"/></svg></span>
              </div>
              <div class="hp-mailbody">
                <div class="hp-rail" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1F6FC5" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B6B6B" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B6B6B" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/></svg>
                </div>
                <div class="hp-folders" aria-hidden="true">
                  <span class="hp-newmail">New mail</span>
                  <span>Inbox <b>12</b></span><span class="on">Drafts <b>1</b></span><span>Sent items</span><span>Archive</span>
                </div>
                <div class="hp-compose">
                  <div class="hp-toolbar" aria-hidden="true"><span class="hp-send">Send</span><span>Discard</span><span>Attach</span><span><b>B</b></span><span><i>I</i></span><span><u>U</u></span></div>
                  <!-- WhisperTyping widget markup: ids must not change -->
                  <div class="editor" id="demo-editor">
                    <div class="editor-chrome">
                      <div class="chrome-row"><span class="label">To</span><span class="value">Sarah Chen</span></div>
                      <div class="chrome-row"><span class="label">Subject</span><span class="value subject">Thursday meeting</span></div>
                    </div>
                    <div class="editor-body" id="demo-body"><span id="demo-text"></span><span class="caret" id="demo-caret"></span></div>
                    <div class="editor-bar">
                      <span class="status" id="demo-status"><span class="dot"></span><span id="demo-status-text">Ready</span></span>
                      <div class="centre-slot">
                        <div class="levels" id="demo-levels" aria-hidden="true"></div>
                        <span class="slot-msg" id="demo-slot-msg" role="status"></span>
                      </div>
                      <div class="bar-actions">
                        <select class="bar-btn lang-select" id="demo-language" aria-label="Dictation language">
                          <option value="" selected>Auto-detect language</option>
                          <option value="en">English</option><option value="nl">Dutch</option><option value="fr">French</option><option value="de">German</option><option value="es">Spanish</option><option value="pt">Portuguese</option><option value="it">Italian</option><option value="ar">Arabic</option><option value="zh">Chinese</option><option value="hi">Hindi</option><option value="ja">Japanese</option><option value="ko">Korean</option><option value="ru">Russian</option><option value="pl">Polish</option><option value="tr">Turkish</option><option value="sv">Swedish</option><option value="da">Danish</option><option value="no">Norwegian</option><option value="fi">Finnish</option><option value="cs">Czech</option><option value="el">Greek</option><option value="he">Hebrew</option><option value="hu">Hungarian</option><option value="id">Indonesian</option><option value="ms">Malay</option><option value="ro">Romanian</option><option value="sk">Slovak</option><option value="uk">Ukrainian</option><option value="vi">Vietnamese</option><option value="th">Thai</option><option value="bg">Bulgarian</option><option value="ca">Catalan</option><option value="hr">Croatian</option><option value="et">Estonian</option><option value="fa">Persian</option><option value="lv">Latvian</option><option value="lt">Lithuanian</option><option value="sl">Slovenian</option><option value="sr">Serbian</option><option value="ta">Tamil</option><option value="ur">Urdu</option><option value="af">Afrikaans</option><option value="bn">Bengali</option><option value="cy">Welsh</option><option value="is">Icelandic</option><option value="sw">Swahili</option><option value="tl">Tagalog</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- floating SRC dictation bar: the live push-to-talk button -->
            <div class="hp-srcbar">
              <button class="ptt" id="demo-ptt" type="button">
                <i class="fa-solid fa-microphone" id="demo-ptt-icon"></i>
                <span id="demo-ptt-label">Hold SPACE to talk</span>
              </button>
              <span class="hp-srcbar-tag"><span class="hp-live-dot"></span>LIVE DEMO</span>
            </div>
            <div class="hp-taskbar" aria-hidden="true">
              <span class="hp-start"></span>
              <span class="hp-tsearch"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>Search</span>
              <span class="hp-ticon"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M2 6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z" fill="#E8B54A"/></svg></span>
              <span class="hp-ticon"><svg width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#3F7FBF"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" stroke="#fff" stroke-width="1.4" fill="none"/></svg></span>
              <span class="hp-ticon on"><svg width="22" height="22" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="3" fill="#1F6FC5"/><path d="M4 7l8 6 8-6" stroke="#fff" stroke-width="1.8" fill="none"/></svg></span>
              <span class="hp-ticon"><span class="hp-srcicon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v1a7 7 0 0 0 14 0v-1"/></svg></span></span>
              <span class="hp-tray">10:42 AM</span>
            </div>
          </div>
        </div>
        <div class="hp-base"><span></span></div>
      </div>

      <div class="challenge-slot hp-challenge" id="demo-turnstile-slot"></div>
      <div class="demo-tips hp-tips" id="demo-tips">
        <span class="tips-lead">Then try saying</span>
        <span class="tip"><b>&ldquo;new paragraph&rdquo;</b> <span class="arrow">&rarr;</span> <span class="result">&para;</span></span>
        <span class="tip"><b>&ldquo;exclamation mark&rdquo;</b> <span class="arrow">&rarr;</span> <span class="result">!</span></span>
        <span class="tip"><b>&ldquo;thumbs up emoji&rdquo;</b> <span class="arrow">&rarr;</span> <span class="result">&#128077;</span></span>
      </div>
      <div class="demo-error" id="demo-error"></div>

      <!-- phones and small tablets: short product loop instead of the laptop -->
      <div class="hp-mobile-demo">
        <video autoplay muted loop playsinline preload="metadata"><source src={`${R2}/speechrecognitioncloud/2026/03/video/speech-to-text-free.mp4`} type="video/mp4" /></video>
        <p>Speak, stop, and the paragraph appears, punctuated. Try the live demo on a computer.</p>
      </div>

      <div class="hp-hero-cta">
        <a href={site.hero.ctaPrimaryUrl} class="hp-btn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>Download free for Windows</a>
        <p><strong>Includes 30 days of Professional, unlimited.</strong> The Windows app does this in Word, Outlook, your records system, anywhere your cursor is. Windows 10/11.</p>
      </div>
    </div>
  </section>

  <!-- 2. HOW THE 30 DAYS WORK -->
  <section class="hp-trial">
    <div class="hp-wrap">
      <div class="hp-rowhead">
        <h2 class="hp-h2">Use all of it for a month.<br /><em>Then decide.</em></h2>
        <a href={site.hero.ctaPrimaryUrl} class="hp-btn hp-btn-red"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>Download free</a>
      </div>
      <div class="hp-days">
        <div><span class="hp-day">Day 1</span><p>Sign up and download. You're on Professional straight away, with unlimited dictation.</p></div>
        <div><span class="hp-day">Days 1 to 30</span><p>Everything unlocked: Ultra Accuracy Mode, AI Modes, templates, screen OCR and the mobile app.</p></div>
        <div><span class="hp-day">Day 31</span><p>Keep Professional, or do nothing and drop to Free: 20 minutes a month, yours to keep.</p></div>
      </div>
    </div>
  </section>

  <!-- 3. VIDEOS -->
  <section class="hp-section" id="demo">
    <div class="hp-wrap">
      <div class="hp-rowhead">
        <h2 class="hp-h2">Watch speech recognition do real work</h2>
        <a href="/support/videos/" class="hp-link">All videos</a>
      </div>
      <div class="hp-videos">
        <figure class="hp-vmain">
          <div class="yt-facade" data-ytid="vp0LFuRWdKI">
            <img src="https://i.ytimg.com/vi/vp0LFuRWdKI/maxresdefault.jpg" width="1280" height="720" alt="Live dictation demo, start to finish" loading="lazy" decoding="async" />
            <div class="yt-play"><svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7c-.8-2.9-2.5-5.4-5.4-6.2C55.8.1 34 0 34 0S12.2.1 6.9 1.6c-2.8.7-4.6 3.2-5.4 6.1C.1 13 0 24 0 24s0 11 1.5 16.3c.8 2.9 2.6 5.4 5.4 6.2C12.2 47.9 34 48 34 48s21.8-.1 27.1-1.6c2.8-.7 4.6-3.2 5.4-6.1C67.9 35 68 24 68 24s0-11-1.5-16.3z" fill="#16150F"/><path d="M27 34V14l18 10-18 10z" fill="#FFF"/></svg></div>
          </div>
        </figure>
        <div class="hp-vlist">
          {[
            { id: '4rlay0Zx660', t: 'A progress note, dictated', m: 'Medical · 1:38' },
            { id: 'V67_C0kq7gs', t: 'Deutsch: one of 57 languages', m: 'Languages · 1:39' },
            { id: '5YlOzjs_paA', t: 'AI Modes: write, rewrite, reply', m: 'Professional · 1:01' },
          ].map(v => (
            <div class="hp-vitem">
              <div class="yt-facade hp-vthumb" data-ytid={v.id}>
                <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} width="320" height="180" alt={v.t} loading="lazy" decoding="async" />
              </div>
              <div><div class="hp-vtitle">{v.t}</div><div class="hp-vmeta">{v.m}</div></div>
            </div>
          ))}
        </div>
      </div>
      <div class="hp-loop">
        <div>
          <p class="hp-kicker">20 seconds, no sound</p>
          <p class="hp-loop-line">Talk into Word. Stop. The paragraph lands, punctuated.</p>
        </div>
        <div class="hp-loop-video">
          <video autoplay muted loop playsinline preload="none"><source src={`${R2}/speechrecognitioncloud/2026/03/video/speech-to-text-free.mp4`} type="video/mp4" /></video>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FOUNDER -->
  <section class="hp-founder" id="credibility">
    <div class="hp-wrap hp-founder-grid">
      <p class="hp-kicker">A note from the founder</p>
      <div>
        <blockquote class="hp-quote"><p>{site.credibility.quote}</p></blockquote>
        <p class="hp-sign"><span class="hp-signame">{site.credibility.founderName}</span><span>{site.credibility.founderTitle}{site.credibility.founderLinkedIn && <> · <a href={site.credibility.founderLinkedIn} target="_blank" rel="noopener noreferrer">LinkedIn</a></>}</span></p>
        <ul class="hp-creds">{site.credibility.credentials.map(c => (<li>{c}</li>))}</ul>
      </div>
    </div>
  </section>

  <!-- 5. FEATURES: SPEC SHEET -->
  <section class="hp-section" id="features">
    <div class="hp-wrap">
      <h2 class="hp-h2">Speech-to-text features, the short version</h2>
      <div class="hp-spec">
        <div><span class="hp-spec-l">Works in</span><span class="hp-spec-v">Any Windows app with a cursor</span><span class="hp-spec-d">Word, Outlook, Chrome, medical records, web forms.</span></div>
        <div><span class="hp-spec-l">Setup</span><span class="hp-spec-v">No voice training</span><span class="hp-spec-d">Install, choose a microphone, dictate. No profiles, no calibration.</span></div>
        <div><span class="hp-spec-l">Languages</span><span class="hp-spec-v">57</span><span class="hp-spec-d">On Free, Personal and Professional. <a href="/languages">See the full list</a>.</span></div>
        <div><span class="hp-spec-l">Punctuation</span><span class="hp-spec-v">Automatic</span><span class="hp-spec-d">Speak naturally. Commas, full stops and capitals go in.</span></div>
        <div><span class="hp-spec-l">Mobile</span><span class="hp-spec-v">Your phone as a microphone</span><span class="hp-spec-d">iPhone and Android, on Professional and Medical Ultra.</span></div>
        <div><span class="hp-spec-l">Your audio</span><span class="hp-spec-v">Processed, then discarded</span><span class="hp-spec-d">Never stored. Never used to train AI models.</span></div>
      </div>
    </div>
  </section>

  <!-- 6. PATHS + PRICING -->
  <section class="hp-paths" id="use-cases">
    <div class="hp-wrap hp-paths-grid">
      <div>
        <h2 class="hp-h2">Speech recognition for your line of work</h2>
        <nav class="hp-pathlist" aria-label="Who it's for">
          <a href="/medical">Doctors and clinicians<span>&rarr;</span></a>
          <a href="/legal">Lawyers<span>&rarr;</span></a>
          <a href="/business">Business<span>&rarr;</span></a>
          <a href="/government">Government<span>&rarr;</span></a>
          <a href="/students">Students<span>&rarr;</span></a>
          <a href="/teachers">Teachers and academics<span>&rarr;</span></a>
          <a href="/writers">Writers and journalists<span>&rarr;</span></a>
          <a href="/accessibility">Accessibility<span>&rarr;</span></a>
        </nav>
      </div>
      <div class="hp-price" id="pricing">
        <p class="hp-kicker">Pricing</p>
        <p class="hp-price-h">30 days of Professional, on us.</p>
        <p>Then keep Professional at $159 a year, choose Personal at $99 a year, or stay on Free at 20 minutes a month. Prices in USD, converted at checkout.</p>
        <a href="/pricing" class="hp-btn hp-btn-light">See plans</a>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="hp-section" id="faq">
    <div class="hp-wrap hp-faq-grid">
      <h2 class="hp-h2 hp-faq-h">Speech recognition questions people ask</h2>
      <div class="hp-faq">
        {site.faq.map(item => (<details class="faq-item"><summary class="faq-question">{item.question}</summary><div class="faq-answer"><p>{item.answer}</p></div></details>))}
      </div>
    </div>
  </section>

</div>

  <style is:inline>
    .hp{--ink:#16150F;--paper:#F6F3EC;--sand:#EDE8DD;--rule:#D9D3C4;--muted:#5E5A4F;--body:#3B3830;--red:#B23A26;background:var(--paper);color:var(--ink);font-family:'DM Sans',system-ui,sans-serif}
    .hp a{color:inherit}
    .hp-wrap{max-width:1120px;margin:0 auto;padding:0 24px}
    .hp-kicker{margin:0 0 12px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .hp-kicker-h1{font-family:inherit;font-weight:400;line-height:1.5;letter-spacing:.08em}
    .hp-h1,.hp-h2,.hp-day,.hp-quote p,.hp-signame,.hp-spec-v,.hp-price-h,.hp-loop-line,.hp-pathlist a,.hp-hero-line{font-family:'Newsreader',Georgia,serif;font-weight:400}
    .hp-h1{margin:0;font-size:clamp(44px,6vw,76px);line-height:.98;letter-spacing:-.025em}
    .hp-h1 em,.hp-h2 em{color:var(--red)}
    .hp-h2{margin:0;font-size:clamp(30px,3.6vw,44px);line-height:1.02;letter-spacing:-.02em}
    .hp-btn{display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:#F6F3EC!important;padding:13px 24px;border-radius:4px;font-weight:600;font-size:15px;text-decoration:none;white-space:nowrap}
    .hp-btn:hover{background:#000}
    .hp-btn-red{background:var(--red)}.hp-btn-red:hover{background:#962F1E}
    .hp-btn-light{background:#F6F3EC;color:var(--ink)!important;align-self:flex-start}
    .hp-link{font-size:16px}
    .hp-section{padding:72px 0;border-top:1px solid var(--rule)}
    .hp-rowhead{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:32px;flex-wrap:wrap}

    /* hero */
    .hp-hero{padding:48px 0 72px}
    .hp-hero-sub{max-width:760px;margin:24px 0 36px}
    .hp-hero-line{margin:0 0 8px;font-size:23px;line-height:1.3}
    .hp-hero-note{margin:0;font-family:'Newsreader',Georgia,serif;font-size:19px;line-height:1.45;color:var(--muted)}
    .hp-steps{list-style:none;margin:0 0 20px;padding:0;display:flex;justify-content:center;align-items:center;gap:16px;font-size:16px;flex-wrap:wrap}
    .hp-steps li{display:flex;align-items:center;gap:12px}
    .hp-num{width:28px;height:28px;font-size:14px;border-radius:50%;background:var(--red);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:600}
    .hp-steps kbd{font-family:inherit;border:1.5px solid var(--ink);border-bottom-width:4px;border-radius:6px;padding:1px 20px;background:#fff;font-weight:600;font-size:14px}
    .hp-arrow{color:#A39C8B}

    /* laptop */
    .hp-laptop{--font-family:'DM Sans',system-ui,sans-serif;--color-bg:#fff;--color-text:#16150F;--color-text-dark:#16150F;--color-text-light:#5E5A4F;--color-text-muted:#8A8577;--color-border:#E5E5E5;--color-border-light:#EDEDED;--color-orange:#B23A26;--gradient-button:#B23A26;--gradient-button-pink:#16150F;--gradient-hero:#B23A26;--radius-lg:10px;--radius-xl:14px;--shadow-card:none;--shadow-lg:none;display:flex;flex-direction:column;align-items:center}
    .hp-lid{width:100%;max-width:940px;box-sizing:border-box;padding:16px 16px 20px;background:#1E1E1C;border-radius:20px 20px 6px 6px;box-shadow:0 40px 80px -40px rgba(22,21,15,.45)}
    .hp-screen{position:relative;height:500px;background:#CBD5DF;border-radius:4px;overflow:hidden;display:flex;flex-direction:column;font-family:'Segoe UI','DM Sans',system-ui,sans-serif}
    .hp-base{width:calc(100% + 40px);max-width:1000px;height:18px;background:#CFCBC2;border-radius:0 0 16px 16px;display:flex;justify-content:center;box-shadow:0 18px 30px -18px rgba(22,21,15,.4)}
    .hp-base span{width:160px;height:8px;background:#B9B4A9;border-radius:0 0 8px 8px}
    .hp-mail{margin:20px 28px 0;flex:1;min-height:0;background:#fff;border-radius:8px 8px 0 0;box-shadow:0 8px 24px rgba(0,0,0,.14);display:flex;flex-direction:column;overflow:hidden;font-size:13px;color:#1F1F1F}
    .hp-titlebar{display:flex;align-items:center;height:40px;background:#1F6FC5;color:#fff;flex-shrink:0}
    .hp-appname{width:170px;padding-left:16px;font-weight:600}
    .hp-search{flex:1;max-width:380px;margin:0 auto;height:26px;border-radius:4px;background:#fff;color:#6B6B6B;display:flex;align-items:center;gap:8px;padding:0 10px}
    .hp-winctl{display:flex}.hp-winctl svg{width:46px;padding:0 18px;box-sizing:border-box}
    .hp-mailbody{flex:1;display:flex;min-height:0}
    .hp-rail{width:48px;background:#F3F3F3;display:flex;flex-direction:column;align-items:center;gap:18px;padding-top:16px;flex-shrink:0}
    .hp-folders{width:160px;border-right:1px solid #E5E5E5;padding:12px 8px;display:flex;flex-direction:column;gap:2px;flex-shrink:0}
    .hp-folders span{display:flex;justify-content:space-between;padding:7px 12px;border-radius:4px}
    .hp-folders b{font-weight:400;color:#6B6B6B}
    .hp-folders .on{background:#DCE7F5;font-weight:600}
    .hp-folders .hp-newmail{background:#1F6FC5;color:#fff;font-weight:600;margin:0 4px 10px}
    .hp-compose{flex:1;display:flex;flex-direction:column;min-width:0}
    .hp-toolbar{display:flex;align-items:center;gap:16px;padding:10px 20px;border-bottom:1px solid #E5E5E5;color:#6B6B6B;flex-shrink:0}
    .hp-send{background:#1F6FC5;color:#fff;padding:6px 18px;border-radius:4px;font-weight:600}
    /* restyle the WhisperTyping editor as the compose pane */
    #hp-demo .editor{flex:1;display:flex;flex-direction:column;border:0;border-radius:0;box-shadow:none;margin:0;max-width:none;width:auto;background:#fff}
    #hp-demo .editor-chrome{padding:0 20px;border:0;background:#fff}
    #hp-demo .chrome-row{padding:9px 0;border-bottom:1px solid #EDEDED;font-size:14px}
    #hp-demo .editor-body{flex:1;padding:14px 18px;font-size:16px;line-height:1.6;min-height:0;overflow:auto;font-family:'DM Sans',system-ui,sans-serif}
    #hp-demo #demo-text:empty::before{content:'Hold SPACE and say something like: \201CHi Sarah, can we move Thursday\2019s meeting to 10?\201D';color:#9A9384}
    #hp-demo .editor-bar{border-top:1px solid #EDEDED;background:#FAFAFA}
    /* floating SRC bar with the real push-to-talk button */
    .hp-srcbar{position:absolute;right:44px;bottom:112px;display:flex;align-items:center;gap:14px;padding:10px 16px 10px 10px;background:#fff;border:2px solid var(--red);border-radius:14px;box-shadow:0 0 0 8px rgba(178,58,38,.12),0 16px 40px -12px rgba(22,21,15,.35);font-family:'DM Sans',sans-serif;z-index:2}
    #hp-demo .ptt{margin:0;position:static;transform:none}
    .hp-srcbar-tag{display:flex;align-items:center;gap:6px;font-size:11px;letter-spacing:.05em;font-weight:600;color:var(--ink)}
    .hp-live-dot{width:7px;height:7px;border-radius:50%;background:var(--red)}
    #hp-demo .ptt{animation:hp-pulse 1.8s ease-out infinite}
    @keyframes hp-pulse{0%{box-shadow:0 0 0 0 rgba(178,58,38,.55)}70%{box-shadow:0 0 0 16px rgba(178,58,38,0)}100%{box-shadow:0 0 0 0 rgba(178,58,38,0)}}
    @media (prefers-reduced-motion:reduce){#hp-demo .ptt{animation:none}}
    .hp-challenge{display:flex;justify-content:center;margin-top:16px}
    .hp-taskbar{height:48px;flex-shrink:0;background:#F3F3F3;border-top:1px solid #D6D6D6;display:flex;align-items:center;justify-content:center;gap:6px;position:relative;font-size:12px;color:#1F1F1F}
    .hp-start{width:36px;height:36px;border-radius:6px;display:flex;align-items:center;justify-content:center}
    .hp-start::before{content:'';width:20px;height:20px;border-radius:5px;border:2px solid #1F6FC5;box-sizing:border-box}
    .hp-tsearch{height:32px;width:200px;border-radius:16px;background:#fff;border:1px solid #DADADA;display:flex;align-items:center;gap:8px;padding:0 12px;box-sizing:border-box;color:#6B6B6B}
    .hp-ticon{width:36px;height:36px;border-radius:6px;display:flex;align-items:center;justify-content:center}
    .hp-ticon.on{background:#E4EAF2}
    .hp-srcicon{width:22px;height:22px;border-radius:6px;background:var(--red);display:flex;align-items:center;justify-content:center}
    .hp-tray{position:absolute;right:16px}
    .hp-tips{justify-content:center;margin-top:28px}
    .hp-mobile-demo{display:none}
    .hp-hero-cta{display:flex;justify-content:center;align-items:center;gap:24px;margin-top:28px;flex-wrap:wrap}
    .hp-hero-cta p{margin:0;max-width:520px;font-size:15px;color:var(--body)}

    /* trial */
    .hp-trial{padding:72px 0;background:var(--sand);border-top:4px solid var(--red)}
    .hp-days{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;border-top:1px solid var(--ink)}
    .hp-days>div{padding-top:28px}
    .hp-day{display:block;font-size:26px;margin-bottom:8px}
    .hp-days p{margin:0;font-size:16px;line-height:1.55;color:var(--body)}

    /* videos */
    .hp-videos{display:grid;grid-template-columns:2fr 1fr;gap:32px}
    .hp-vmain{margin:0}
    .hp .yt-facade{position:relative;cursor:pointer;border-radius:8px;overflow:hidden;background:#fff;aspect-ratio:16/9;border:1px solid var(--rule);box-shadow:0 1px 0 var(--rule),0 24px 48px -24px rgba(22,21,15,.35)}
    .hp .hp-vthumb{box-shadow:0 10px 24px -14px rgba(22,21,15,.4)}
    .hp .yt-facade img{width:100%;height:100%;object-fit:cover;display:block}
    .hp .yt-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}
    .hp .yt-facade iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
    .hp-vmain figcaption{display:flex;justify-content:space-between;margin-top:14px;font-size:18px;font-weight:600}
    .hp-dur,.hp-vmeta{color:var(--muted);font-weight:400}
    .hp-vlist{display:flex;flex-direction:column;gap:22px}
    .hp-vitem{display:flex;gap:16px;align-items:center;padding-bottom:22px;border-bottom:1px solid var(--rule)}
    .hp-vthumb{width:150px;flex-shrink:0;border-radius:3px}
    .hp-vtitle{font-size:15px;font-weight:600;line-height:1.3}
    .hp-vmeta{font-size:13px;margin-top:4px}
    .hp-loop{display:grid;grid-template-columns:1fr 2fr;gap:32px;align-items:center;margin-top:56px}
    .hp-loop-line{margin:0;font-size:26px;line-height:1.2}
    .hp-loop-video{border-radius:4px;overflow:hidden;background:var(--sand)}
    .hp-loop-video video{width:100%;display:block}

    /* founder */
    .hp-founder{padding:80px 0;background:var(--sand)}
    .hp-founder-grid{display:grid;grid-template-columns:1fr 2fr;gap:32px}
    .hp-quote{margin:0;padding:0;border:0}
    .hp-quote p{margin:0;font-size:clamp(22px,2.4vw,29px);line-height:1.3;letter-spacing:-.01em}
    .hp-sign{display:flex;align-items:baseline;gap:20px;margin:32px 0;flex-wrap:wrap;font-size:15px;color:var(--muted)}
    .hp-signame{font-style:italic;font-size:24px;color:var(--ink)}
    .hp-creds{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;column-gap:32px;border-top:1px solid #C9C1AF}
    .hp-creds li{padding:14px 0;border-bottom:1px solid #C9C1AF;font-size:15px;line-height:1.5;color:var(--body)}

    /* spec sheet */
    .hp-spec{margin-top:32px;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)}
    .hp-spec>div{display:grid;grid-template-columns:3fr 5fr 4fr;gap:32px;padding:20px 0;align-items:baseline}
    .hp-spec>div+div{border-top:1px solid var(--rule)}
    .hp-spec-l{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .hp-spec-v{font-size:26px;line-height:1.15;letter-spacing:-.01em}
    .hp-spec-d{font-size:15px;line-height:1.5;color:var(--body)}

    /* paths + pricing */
    .hp-paths{padding:80px 0;background:var(--ink);color:#F6F3EC}
    .hp-paths .hp-kicker{color:#BDB6A6}
    .hp-paths-grid{display:grid;grid-template-columns:7fr 1fr 4fr;gap:32px;align-items:end}
    .hp-paths-grid>.hp-price{grid-column:3}
    .hp-pathlist{margin-top:28px;border-bottom:1px solid #3B3830}
    .hp-pathlist a{display:flex;justify-content:space-between;padding:14px 0;border-top:1px solid #3B3830;color:#F6F3EC;text-decoration:none;font-size:22px}
    .hp-pathlist a:hover{color:#E9A393}
    .hp-price{border:1px solid #3B3830;border-radius:4px;padding:28px;display:flex;flex-direction:column;gap:16px}
    .hp-price p{margin:0;font-size:15px;line-height:1.5;color:#D9D3C4}
    .hp-price .hp-kicker{margin:0}
    .hp-price-h{font-size:30px!important;line-height:1.1!important;color:#F6F3EC!important}

    /* faq */
    .hp-faq-grid{display:grid;grid-template-columns:1fr 2fr;gap:32px}
    .hp-faq{border-top:1px solid var(--ink)}
    .hp .faq-item{border-bottom:1px solid var(--rule)}
    .hp .faq-question{padding:16px 0;font-size:16px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
    .hp .faq-question::-webkit-details-marker{display:none}
    .hp .faq-question::after{content:'+';color:var(--red);font-size:22px}
    .hp .faq-item[open] .faq-question::after{content:'\2212'}
    .hp .faq-answer p{margin:0 0 16px;font-size:15px;line-height:1.6;color:var(--body)}

    /* responsive */
    @media (max-width:1024px){
      .hp-screen{height:460px}.hp-folders{display:none}
      .hp-paths-grid{grid-template-columns:1fr}.hp-paths-grid>.hp-price{grid-column:auto}
    }
    @media (max-width:860px){
      .hp-steps,.hp-laptop,.hp-tips,#demo-error{display:none}
      .hp-mobile-demo{display:block;margin-top:8px}
      .hp-mobile-demo video{width:100%;display:block;border-radius:6px}
      .hp-mobile-demo p{margin:12px 0 0;font-size:15px;color:var(--muted)}
      .hp-hero-sub,.hp-days,.hp-videos,.hp-loop,.hp-founder-grid,.hp-faq-grid,.hp-creds{grid-template-columns:1fr}
      .hp-spec>div{grid-template-columns:1fr;gap:6px}
      .hp-spec-v{font-size:22px}
      .hp-section,.hp-trial,.hp-founder,.hp-paths{padding:56px 0}
      .hp-hero-cta{justify-content:flex-start}
      .hp-pathlist a{font-size:19px}
    }
  </style>
