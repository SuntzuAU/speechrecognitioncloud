---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import site from '../../site.config.json';

export async function getStaticPaths() {
  const posts = await getCollection('learn');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const toc = (headings || []).filter(h => h.depth === 2 && h.slug && h.text !== 'Who wrote this?');
const allPosts = (await getCollection('learn'))
  .filter(p => p.slug !== post.slug)
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 3);
const wordCount = post.body.trim().split(/\s+/).length;
const modified = post.data.updated || post.data.date;
const R2_BASE = (import.meta.env.PUBLIC_R2_BASE ?? 'https://pub-c7a09e1ddb7c45e6a38fcdca1e4b6897.r2.dev').replace(/\/$/, '');
const imgSrc = (key) => key ? (/^https?:\/\//.test(key) ? key : `${R2_BASE}/${key}`) : '';
const typeLabels = { article: 'Article', guide: 'Guide', video: 'Video', tip: 'Tip' };

// Cloudflare image transformations (enabled on the speechrecognition.cloud zone,
// with pub-...r2.dev registered as an allowed source origin).
const CF_WIDTHS = [380, 760, 1140, 1520];
const cfImg = (url, w) => `/cdn-cgi/image/width=${w},format=auto,quality=85/${url}`;
const cfSrcset = (url) => url ? CF_WIDTHS.map(w => `${cfImg(url, w)} ${w}w`).join(', ') : '';
const CF_SIZES = '(max-width: 800px) 100vw, 760px';

// AEO: FAQPage schema from question-style headings, plus BlogPosting with author
const faqSchema = post.data.faq && post.data.faq.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
} : null;

const canonical = `${site.siteUrl.replace(/\/$/, "")}/learn/${post.slug}/`;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date,
  "dateModified": modified,
  "wordCount": wordCount,
  "articleSection": post.data.articleSection || "Speech recognition",
  "inLanguage": post.data.lang || "en-US",
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  ...(post.data.heroImage ? { "image": imgSrc(post.data.heroImage) } : {}),
  "author": {
    "@type": "Person",
    "name": "Russell Bewsell",
    "jobTitle": "Founder",
    "url": "https://www.linkedin.com/in/rbewsell/"
  },
  "publisher": { "@type": "Organization", "name": "Speech Recognition Cloud" }
};

const extraSchema = [articleSchema, ...(faqSchema ? [faqSchema] : [])];
---
<BaseLayout
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  lang={post.data.lang}
  description={post.data.seoDescription || post.data.description}
  extraSchema={extraSchema}
  ogImage={post.data.heroImage ? imgSrc(post.data.heroImage) : (post.data.youtubeId ? `https://i.ytimg.com/vi/${post.data.youtubeId}/maxresdefault.jpg` : undefined)}
  ogType="article"
  articleMeta={{ publishedTime: post.data.date, modifiedTime: modified, author: 'Russell Bewsell', section: post.data.articleSection || 'Speech recognition' }}>
  <article class="section-pad">
    <div class="container" style="max-width:760px">
      <div class="article-meta">
        <a href="/learn" class="back-link"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Back to Learn</a>
        <div style="display:flex;align-items:center;gap:10px">
          <span class={`learn-tag learn-tag--${post.data.type}`}>{typeLabels[post.data.type] || post.data.type}</span>
          <time datetime={post.data.date} class="muted">{new Date(post.data.date).toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </div>
      </div>
      <h1 class="article-title">{post.data.title}</h1>

      {post.data.heroImage && (
        <div class="hero-img"><img src={cfImg(imgSrc(post.data.heroImage), 1140)} srcset={cfSrcset(imgSrc(post.data.heroImage))} sizes={CF_SIZES} alt={post.data.heroImageAlt ?? post.data.title} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" /></div>
      )}

      {post.data.youtubeId && (
        <div class="yt-facade" data-ytid={post.data.youtubeId} style="margin-bottom:32px">
          <img src={`https://i.ytimg.com/vi/${post.data.youtubeId}/maxresdefault.jpg`} alt={post.data.title} loading="eager" />
          <div class="yt-play"><svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7c-.8-2.9-2.5-5.4-5.4-6.2C55.8.1 34 0 34 0S12.2.1 6.9 1.6c-2.8.7-4.6 3.2-5.4 6.1C.1 13 0 24 0 24s0 11 1.5 16.3c.8 2.9 2.6 5.4 5.4 6.2C12.2 47.9 34 48 34 48s21.8-.1 27.1-1.6c2.8-.7 4.6-3.2 5.4-6.1C67.9 35 68 24 68 24s0-11-1.5-16.3z" fill="#FF0000"/><path d="M27 34V14l18 10-18 10z" fill="#FFF"/></svg></div>
        </div>
      )}

      {toc.length >= 4 && (
        <nav class="toc" aria-label="On this page">
          <h2 class="toc-title">On this page</h2>
          <ul>
            {toc.map(h => (<li><a href={`#${h.slug}`}>{h.text}</a></li>))}
          </ul>
        </nav>
      )}
      <div class="article-body" id="article-prose"
        data-break1={post.data.breakImage1 ? cfImg(imgSrc(post.data.breakImage1), 1140) : ''}
        data-break1-srcset={post.data.breakImage1 ? cfSrcset(imgSrc(post.data.breakImage1)) : ''}
        data-break1-alt={post.data.breakImage1Alt ?? ''}
        data-break2={post.data.breakImage2 ? cfImg(imgSrc(post.data.breakImage2), 1140) : ''}
        data-break2-srcset={post.data.breakImage2 ? cfSrcset(imgSrc(post.data.breakImage2)) : ''}
        data-break2-alt={post.data.breakImage2Alt ?? ''}>
        <Content />
      </div>
    </div>
  </article>
  {allPosts.length > 0 && (
    <section class="section-pad">
      <div class="container" style="max-width:760px">
        <h2 style="font-size:24px;margin-bottom:20px">Related reading</h2>
        <ul class="related-list">
          {allPosts.map(p => (
            <li>
              <a href={`/learn/${p.slug}/`}>
                <span class="related-title">{p.data.title}</span>
                <span class="related-desc">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <section class="section-pad section-neutral">
    <div class="container text-center" style="max-width:600px">
      <h2 style="margin-bottom:12px">Try Speech Recognition Cloud</h2>
      <p class="muted" style="margin-bottom:24px">Free to download. No credit card required.</p>
      <a href={site.download.url} class="btn-primary">Download free</a>
    </div>
  </section>
  <style is:inline>
    .article-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px}
    .back-link{display:inline-flex;align-items:center;gap:4px;font-size:14px;color:var(--brand);font-weight:600;text-decoration:none}
    .back-link:hover{text-decoration:underline}
    .learn-tag{font-size:11px;font-weight:600;padding:2px 8px;border-radius:6px;text-transform:uppercase;letter-spacing:0.04em}
    .learn-tag--article{color:var(--brand);background:var(--brand-lightest, #EEF2FF)}
    .learn-tag--guide{color:#059669;background:#ECFDF5}
    .learn-tag--video{color:#DC2626;background:#FEF2F2}
    .learn-tag--tip{color:#D97706;background:#FFFBEB}
    .hero-img{margin-bottom:32px;border-radius:16px;overflow:hidden;background:#F1F5F9}
    .hero-img img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
    .toc{margin:0 0 36px;padding:20px 24px;border:1px solid var(--border);border-radius:14px;background:var(--neutral)}
    .toc-title{font-size:14px!important;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin:0 0 12px!important;padding:0!important;border:0!important}
    .toc ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}
    .toc li{margin:0;line-height:1.5}
    .toc a{color:var(--brand);font-weight:500;font-size:15px}
    .toc a:hover{text-decoration:underline}
    .related-list{list-style:none;margin:0;padding:0;display:grid;gap:14px}
    .related-list li{margin:0}
    .related-list a{display:block;padding:18px 20px;border:1px solid var(--border);border-radius:14px;transition:box-shadow .2s,border-color .2s}
    .related-list a:hover{border-color:var(--brand-light);box-shadow:0 4px 16px rgba(15,23,42,.06)}
    .related-title{display:block;font-weight:700;color:var(--text);margin-bottom:6px;line-height:1.4}
    .related-desc{display:block;font-size:14px;color:var(--muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .img-break{margin:32px 0;border-radius:14px;overflow:hidden;background:#F1F5F9}
    .img-break img{width:100%;max-height:360px;object-fit:cover;display:block}
    .article-title{font-size:clamp(28px,4vw,40px);font-weight:800;margin-bottom:32px;line-height:1.2;letter-spacing:-0.02em}
    .article-body{font-size:16px;line-height:1.8;color:var(--text)}
    .article-body h2{font-size:24px;font-weight:700;margin-top:40px;margin-bottom:16px}
    .article-body h3{font-size:20px;font-weight:600;margin-top:32px;margin-bottom:12px}
    .article-body p{margin-bottom:20px;color:var(--muted)}
    .article-body a{color:var(--brand);font-weight:600}
    .article-body ul,.article-body ol{margin-bottom:20px;padding-left:24px;color:var(--muted)}
    .article-body li{margin-bottom:8px;line-height:1.7}
    .article-body blockquote{border-left:3px solid var(--brand);padding-left:20px;margin:24px 0;font-style:italic;color:var(--muted)}
    /* --- tables --- */
    .article-body table{width:100%;border-collapse:separate;border-spacing:0;margin:30px 0;font-size:15px;line-height:1.6;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:#fff;box-shadow:0 1px 2px rgba(15,23,42,0.04)}
    .article-body th,.article-body td{padding:13px 16px;text-align:left;vertical-align:top;border:0;border-bottom:1px solid var(--border)}
    .article-body thead th{background:linear-gradient(180deg,#EEF2FF 0%,#E7EAFD 100%);color:var(--text);font-weight:700;font-size:14px;letter-spacing:-0.01em;border-bottom:2px solid var(--brand-light,#818CF8);white-space:nowrap}
    .article-body tbody tr:last-child td{border-bottom:0}
    .article-body tbody tr:hover{background:#FAFBFF}
    .article-body td strong,.article-body th strong{color:var(--text)}
    .article-body td:first-child{font-weight:600;color:var(--text)}

    /* --- status pills --- */
    .st{display:inline-block;font-size:12px;font-weight:700;padding:4px 11px;border-radius:99px;white-space:nowrap;letter-spacing:0.01em;line-height:1.4}
    .st-live{background:#DCFCE7;color:#15803D;box-shadow:inset 0 0 0 1px #86EFAC}
    .st-end{background:#FFEDD5;color:#C2410C;box-shadow:inset 0 0 0 1px #FDBA74}
    .st-gone{background:#FEE2E2;color:#B91C1C;box-shadow:inset 0 0 0 1px #FCA5A5}
    .st-best{background:var(--brand-lightest,#EEF2FF);color:var(--brand);box-shadow:inset 0 0 0 1px #A5B4FC}
    .article-body tr.row-end td{background:#FFFBF5}
    .article-body tr.row-best td{background:#F5F6FE}

    /* --- callouts --- */
    .callout{margin:30px 0;padding:22px 26px;border-radius:14px;border:1px solid var(--border);border-left:4px solid var(--brand);background:var(--brand-lightest,#EEF2FF)}
    .callout--warn{border-left-color:#EA580C;background:#FFF7ED;border-color:#FDBA74}
    .callout--stop{border-left-color:#B91C1C;background:#FEF2F2;border-color:#FCA5A5}
    .callout h4{margin:0 0 8px;font-size:16px;font-weight:700;color:var(--text);letter-spacing:-0.01em}
    .callout p{margin:0 0 8px;font-size:15px;line-height:1.7;color:var(--text)}
    .callout p:last-child{margin-bottom:0}
    .callout--warn h4{color:#9A3412}
    .callout--stop h4{color:#991B1B}

    /* --- key figure cards --- */
    .kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:28px 0}
    .kpi .k{padding:18px 20px;border:1px solid var(--border);border-radius:14px;background:#fff}
    .kpi .k.win{border-color:var(--brand);background:linear-gradient(180deg,#F5F6FE 0%,#EEF2FF 100%)}
    .kpi .k.bad{border-color:#FDBA74;background:linear-gradient(180deg,#FFFBF5 0%,#FFF7ED 100%)}
    .kpi .k-l{font-size:13px;color:var(--muted);margin:0 0 6px;line-height:1.45}
    .kpi .k-v{font-size:24px;font-weight:800;margin:0;letter-spacing:-0.025em;color:var(--text)}
    .kpi .k.win .k-v{color:var(--brand)}
    .kpi .k.bad .k-v{color:#C2410C}

    /* --- article rhythm --- */
    .article-body h2{padding-top:6px;border-top:1px solid var(--border);margin-top:44px}
    .article-body h2:first-of-type{border-top:0;padding-top:0}
    .article-body hr{border:0;border-top:1px solid var(--border);margin:36px 0}
    @media(max-width:640px){.article-body table{font-size:13.5px}.article-body th,.article-body td{padding:10px 11px}.callout{padding:18px 20px}}
    .yt-facade{position:relative;max-width:100%;cursor:pointer;border-radius:16px;overflow:hidden;background:#000;box-shadow:0 8px 32px rgba(0,0,0,0.12)}.yt-facade img{width:100%;aspect-ratio:16/9;object-fit:cover}.yt-facade .yt-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);opacity:0.9;transition:opacity 0.2s}.yt-facade:hover .yt-play{opacity:1}.yt-facade iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:0}
  </style>
  <script is:inline>
    document.querySelectorAll('.yt-facade').forEach(function(el){el.addEventListener('click',function(){var id=el.dataset.ytid;var iframe=document.createElement('iframe');iframe.src='https://www.youtube-nocookie.com/embed/'+id+'?autoplay=1&rel=0&modestbranding=1';iframe.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';iframe.allowFullscreen=true;el.innerHTML='';el.style.paddingBottom='56.25%';el.style.height='0';el.appendChild(iframe);});});
  </script>
  <script is:inline>
    (function () {
      var prose = document.getElementById('article-prose');
      if (!prose) return;
      var b1 = prose.getAttribute('data-break1'), b1a = prose.getAttribute('data-break1-alt') || '', b1s = prose.getAttribute('data-break1-srcset') || '';
      var b2 = prose.getAttribute('data-break2'), b2a = prose.getAttribute('data-break2-alt') || '', b2s = prose.getAttribute('data-break2-srcset') || '';
      if (!b1 && !b2) return;
      var h2s = prose.querySelectorAll('h2');
      if (!h2s.length) return;
      function mk(src, alt, ss) {
        var w = document.createElement('div'); w.className = 'img-break';
        var i = document.createElement('img'); i.src = src; i.alt = alt; i.width = 1600; i.height = 686; i.loading = 'lazy'; i.decoding = 'async';
        if (ss) { i.srcset = ss; i.sizes = '(max-width: 800px) 100vw, 760px'; }
        w.appendChild(i); return w;
      }
      if (b1 && h2s.length >= 2) prose.insertBefore(mk(b1, b1a, b1s), h2s[1]);
      if (b2) {
        var idx = Math.max(2, Math.floor(h2s.length * 2 / 3));
        if (h2s.length > idx) prose.insertBefore(mk(b2, b2a, b2s), h2s[idx]);
      }
    })();
  </script>
</BaseLayout>
